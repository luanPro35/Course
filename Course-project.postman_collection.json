			"name": "Auth",
			"item": [
				{
					"name": "login",
					"event": [
						{
							"listen": "prerequest",
							"script": {
								"exec": [
									"// No actions needed in pre-request script for login token extraction.",
									""
								],
								"type": "text/javascript",
								"packages": {},
								"requests": {}
							}
						},
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 200\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"// Parse JSON from response",
									"let response;",
									"try {",
									"    response = pm.response.json();",
									"} catch (e) {",
									"    response = {};",
									"}",
									"",
									"// Save token to environment variable",
									"if (response.token) {",
									"    pm.environment.set(\"accessToken\", response.token);",
									"}",
									"",
									"// Test that token exists",
									"pm.test(\"Token received\", function () {",
									"    pm.expect(response.token).to.not.be.undefined;",
									"});"
								],
								"type": "text/javascript",
								"packages": {},
								"requests": {}
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [],
						"body": {
							"mode": "raw",
							"raw": "{\r\n  \"email\": \"loint.24ite@vku.udn.vn\",\r\n  \"password\": \"12345678\"\r\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "http://localhost:8080/project/auth/login",
							"protocol": "http",
							"host": [
								"localhost"
							],
							"port": "8080",
							"path": [
								"project",
								"auth",
								"login"
							]
						},
						"description": "This is a POST request used to log in a user. It expects a JSON body with the following fields:\n\n- `email`: The user's email address\n- `password`: The user's password\n\nA successful login returns a `200 OK` status and a JSON response containing an authentication token. Example request body:\n\n```\n{\n  \"email\": \"user@example.com\",\n  \"password\": \"your_password\"\n}\n```\n"
					},
					"response": []
