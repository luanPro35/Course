				{
					"name": "login",
					"event": [
						{
							"listen": "prerequest",
							"script": {
								"exec": [
									"// No actions needed in pre-request script for login token extraction.",
									""
								],
								"type": "text/javascript",
								"packages": {},
								"requests": {}
							}
						},
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 200\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"// Parse JSON from response",
									"let response;",
									"try {",
									"    response = pm.response.json();",
									"} catch (e) {",
									"    response = {};",
									"}",
									"",
									"// Save token to environment variable",
									"if (response.token) {",
									"    pm.environment.set(\"accessToken\", response.token);",
									"}",
									"",
									"// Test that token exists",
									"pm.test(\"Token received\", function () {",
									"    pm.expect(response.token).to.not.be.undefined;",
									"});"
								],
								"type": "text/javascript",
								"packages": {},
								"requests": {}
							}
						}
					],
